new file mode 100644
index 00000000..b12af261
--- /dev/null
+++ b/server/api/remediationactions.ts
@@ -0,0 +1,67 @@
+/** Page actions are always resolved from the authorized project's stored section. */
+export function registerRemediationActions(router: any, { base, access, Project, WorkItems, bridge = callBridge }: any) {
+  router.post(`${base}/page/:sectionID/:action`, ...access, async (req: any, res: any) => {
+    try {
+      const section = (req.queueProject.a11yReview || []).find((s: any) => String(s._id) === req.params.sectionID);
+      if (!section) return res.status(404).json({ err: true, errMsg: 'Page is not in this project.' });
+      const endpoints: Record<string, string> = { scan: 'scan', preview: 'preview-fix', 'revise-preview': 'revise-preview', apply: 'apply-fix', snapshots: 'snapshots', 'restore-preview': 'restore-preview', restore: 'restore' };
+      const action = req.params.action;
+      if (!endpoints[action]) return res.status(400).json({ err: true, errMsg: 'Unknown page action.' });
+      const url = new URL(section.sectionURL);
+      const path = decodeURIComponent(url.pathname);
+      if (url.protocol !== 'https:' || url.hostname !== 'dev.libretexts.org' || !(path === '/Sandboxes/johnnyphung' || path.startsWith('/Sandboxes/johnnyphung/'))) {
+        return res.status(403).json({ err: true, errMsg: 'Remediation is limited to the Johnny sandbox.' });
+      }
+      const item = req.body.itemID ? await WorkItems.findOne({ _id: req.body.itemID, projectID: req.params.projectID, sectionID: req.params.sectionID }).lean() : null;
+      if (req.body.itemID && !item) return res.status(404).json({ err: true, errMsg: 'Work item is not on this project page.' });
+      const page = { page_url: section.sectionURL, section_title: section.sectionTitle };
+      // Browser-provided URLs, IDs, snapshots paths and scan evidence are never forwarded.
+      const body = { ...page, finding_ids: req.body.findingIDs, fix_mode: req.body.fixMode,
+        tier: req.body.tier, preview_hash: req.body.previewHash, preview_token: req.body.previewToken,
+        alt_edits: req.body.altEdits, snapshot_timestamp: req.body.snapshotTimestamp };
+      const scan = () => bridge('scan', { ...page, wcag_review: section.wcagReview, doj_exceptions: section.dojExceptions || [] });
+      const persistScan = async (result: any) => {
+        await Project.updateOne({ projectID: req.params.projectID, 'a11yReview._id': section._id }, {
+          $set: { 'a11yReview.$.wcagReview': result.wcag_review || result.wcagReview,
+            'a11yReview.$.dojExceptions': result.doj_exceptions || result.dojExceptions || [] },
+        });
+      };
+      const result = action === 'scan' ? await scan() : await bridge(endpoints[action], body);
+      let scanResult = action === 'scan' ? result : null;
+      let scanError: string | undefined;
+      if (action === 'apply' || action === 'restore') {
+        try { scanResult = await scan(); } catch { scanError = 'The page action completed, but rescan failed. Use Rescan page to retry.'; }
+      }
+      if (scanResult) {
+        try { await persistScan(scanResult); } catch { scanError = 'Scan completed but the matrix could not be saved. Rescan to retry.'; }
+      }
+      let evidenceError: string | undefined;
+      if (item && ['scan', 'apply', 'restore'].includes(action)) {
+        const criterion = (scanResult?.wcag_review || scanResult?.wcagReview)?.criteria?.find((c: any) => c.id === item.criterionID);
+        const findings = scanResult?.findings?.filter((f: any) => f.ruleId === item.ruleId && (!item.selector || f.selector === item.selector));
+        const evidence = { action, at: new Date(), actor: req.user.decoded.uuid,
+          scannedAt: scanResult?.scanned_at, criterion, findings,
+          result: action === 'scan' ? undefined : result, scanError };
+        try {
+          await WorkItems.updateOne({ _id: item._id, projectID: req.params.projectID }, { $push: { scanEvidence: evidence }, $inc: { version: 1 } });
+        } catch { evidenceError = 'Page action completed but task evidence could not be saved. Rescan from this task to retry.'; }
+      }
+      res.json({ err: false, ...result, page_url: section.sectionURL, scan: scanResult ? { ...scanResult, page_url: section.sectionURL } : null, scanError, evidenceError });
+    } catch (e: any) { res.status(e.status || 500).json({ err: true, errMsg: e.publicMessage || 'Page action failed. Refresh and try again.' }); }
+  });
+}
+
+async function callBridge(action: string, body: unknown) {
+  const base = (process.env.REMEDY_API_BASE_URL || process.env.PROJECT_REMEDY_BASE_URL || 'http://127.0.0.1:8000').replace(/\/+$/, '');
+  const key = process.env.REMEDY_API_KEY || process.env.PROJECT_REMEDY_API_KEY;
+  const response = await fetch(`${base}/v1/cxone/page/${action}`, { method: 'POST',
+    headers: { 'Content-Type': 'application/json', ...(key ? { 'X-API-Key': key } : {}) },
+    body: JSON.stringify(body), signal: AbortSignal.timeout(600_000) });
+  const data: any = await response.json();
+  if (!response.ok) {
+    const err: any = new Error('Bridge rejected action'); err.status = response.status;
+    err.publicMessage = data.detail?.message || (typeof data.detail === 'string' ? data.detail : 'Remedy could not complete this action.');
+    throw err;
+  }
+  return data;
+}
