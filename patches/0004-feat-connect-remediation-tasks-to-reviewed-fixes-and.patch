@@ -0,0 +1,97 @@
+import React, { useState } from 'react';
+
+export default function RemediationPageActions({ base, section, item, request, refreshed, close }: any) {
+  const [scan, setScan] = useState<any>(null);
+  const [selected, setSelected] = useState<string[]>([]);
+  const [mode, setMode] = useState('deterministic');
+  const [preview, setPreview] = useState<any>(null);
+  const [snapshots, setSnapshots] = useState<any[]>([]);
+  const [snapshot, setSnapshot] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [message, setMessage] = useState('');
+  const [reviewed, setReviewed] = useState(false);
+  const [altEdits, setAltEdits] = useState<Record<string, string>>({});
+  const [lastSnapshot, setLastSnapshot] = useState('');
+  const invalidate = () => { setPreview(null); setReviewed(false); setAltEdits({}); };
+  const call = (action: string, body: any = {}) => request(`${base}/page/${encodeURIComponent(section.id)}/${action}`, 'POST', { ...body, itemID: item?._id });
+  const selectFindings = (result: any) => {
+    setScan(result);
+    const matches = (result.findings || []).filter((f: any) => f.fixable && item && f.ruleId === item.ruleId && (!item.selector || f.selector === item.selector));
+    setSelected(matches.map((f: any) => f.id));
+  };
+  async function act(action: string) {
+    setBusy(true); setError(''); setMessage('');
+    try {
+      if (action === 'scan') {
+        invalidate(); const result = await call('scan'); selectFindings(result);
+        setMessage(result.scanError || result.evidenceError || 'Rescan complete. Evidence attached to the task; reviewer verification is still required.');
+      } else if (action === 'snapshots') {
+        invalidate(); const result = await call('snapshots'); setSnapshots(result.snapshots || []); setSnapshot('');
+        setMessage(result.snapshots?.length ? 'Choose a saved version and preview the restoration.' : 'No saved versions for this page.');
+      } else if (action === 'revise-preview') {
+        const result = await call('revise-preview', { previewToken: preview.preview_token, altEdits: Object.entries(altEdits).map(([src, text]) => ({ src, text })) });
+        setReviewed(false); setAltEdits({}); setPreview({ ...result, kind: 'apply' });
+        setMessage('Description updated. Review the revised preview before applying.');
+      } else if (action === 'preview' || action === 'restore-preview') {
+        invalidate(); const result = await call(action, { findingIDs: selected, fixMode: mode === 'deterministic' ? mode : 'pipeline', tier: mode === 'advanced' ? 3 : 2, snapshotTimestamp: snapshot });
+        setAltEdits({}); setPreview({ ...result, kind: action === 'preview' ? 'apply' : 'restore' });
+      } else {
+        const result = await call(action, { findingIDs: selected, fixMode: mode === 'deterministic' ? mode : 'pipeline', previewHash: preview.preview_hash, previewToken: preview.preview_token });
+        invalidate(); if (result.scan) selectFindings(result.scan);
+        if (result.snapshot_path) setLastSnapshot(result.snapshot_path.split('/').pop());
+        setMessage(`${action === 'apply' ? 'Apply' : 'Restore'} completed. ${result.scanError || result.evidenceError || 'Rescan complete; evidence attached. Final verification remains with the reviewer.'}`);
+      }
+      await refreshed();
+    } catch (e: any) { setError(e.message); if (action === 'apply' || action === 'restore') invalidate(); }
+    finally { setBusy(false); }
+  }
+  const images: any[] = [];
+  if (preview?.before_html && preview.kind === 'apply') {
+    const before = new DOMParser().parseFromString(preview.before_html, 'text/html');
+    const after = new DOMParser().parseFromString(preview.after_html, 'text/html');
+    for (const finding of (scan?.findings || []).filter((f: any) => selected.includes(f.id))) {
+      try {
+        const findImage = (doc: Document) => finding.data?.src ? Array.from(doc.querySelectorAll('img')).find(img => img.getAttribute('src') === finding.data.src) : doc.querySelector(finding.selector);
+        const original = findImage(before), changed = findImage(after);
+        if (original?.tagName !== 'IMG' || !changed) continue;
+        const src = new URL(original.getAttribute('src') || '', scan.page_url).href;
+        if (src.startsWith('https:')) images.push({ src, source: original.getAttribute('src'), before: original.getAttribute('alt'), after: changed.getAttribute('alt') });
+      } catch { /* Full HTML remains available if a scanner selector cannot be resolved. */ }
+    }
+  }
+  return <section aria-label="Page remediation" className="ui segment">
+    <h3>Remediate: {section.title}</h3>
+    {item && <p>Task: {item.title}</p>}
+    <p>Preview changes, review the result, then apply. Apply and restore both rescan the page. Restore replaces the full page body with the selected saved version.</p>
+    {error && <div role="alert" className="ui negative message">{error}</div>}
+    <div role="status">{busy ? 'Working…' : message}</div>
+    {message && <p><button type="button" className="ui button" disabled={busy} onClick={() => window.location.reload()}>Reload matrix from saved scan</button></p>}
+    {lastSnapshot && <p>Recovery snapshot saved: <code>{lastSnapshot}</code></p>}
+    <div className="rq-fields">
+      <button type="button" className="ui button" disabled={busy} onClick={() => act('scan')}>Rescan page</button>
+      <button type="button" className="ui button" disabled={busy} onClick={() => act('snapshots')}>Restore saved version</button>
+      <button type="button" className="ui button" disabled={busy} onClick={close}>Close page actions</button>
+    </div>
+    {scan && <>
+      <p>Latest scan: {scan.scanned_at}. {scan.findings?.length || 0} findings. {item && !selected.length && 'The task finding is not currently selected; inspect the results before proceeding.'}</p>
+      <label>Remediation mode<select value={mode} disabled={busy} onChange={e => { setMode(e.target.value); invalidate(); }}>
+        <option value="deterministic">Selected findings</option><option value="ai">AI page review (Tier 2)</option><option value="advanced">Advanced AI page review (Tier 3)</option>
+      </select></label>
+      {mode !== 'deterministic' && <p>This mode previews changes across the entire page. Review all changes before applying.</p>}
+      <div className="rq-candidates">{(scan.findings || []).map((f: any) => <label key={f.id}><input type="checkbox" disabled={busy || !f.fixable || mode !== 'deterministic'} checked={selected.includes(f.id)} onChange={e => { setSelected(prev => e.target.checked ? [...prev, f.id] : prev.filter(x => x !== f.id)); invalidate(); }} />{f.message}{!f.fixable && ' (manual review)'}</label>)}</div>
+      <button type="button" className="ui primary button" disabled={busy || (mode === 'deterministic' && !selected.length)} onClick={() => act('preview')}>Preview selected fix</button>
+    </>}
+    {!!snapshots.length && <div className="ui segment"><label>Saved version<select disabled={busy} value={snapshot} onChange={e => { setSnapshot(e.target.value); invalidate(); }}><option value="">Choose a saved version</option>{snapshots.map(s => <option key={s.timestamp} value={s.timestamp}>{s.timestamp} — {s.summary} — {s.hash}</option>)}</select></label><button className="ui button" disabled={busy || !snapshot} onClick={() => act('restore-preview')}>Preview restore</button></div>}
+    {preview && <div className="ui segment">
+      <h4>{preview.kind === 'restore' ? 'Restore preview' : 'Fix preview'}</h4>
+      {images.map((i, n) => <figure key={n}><img src={i.src} alt="Source image being reviewed for its proposed description" style={{ maxWidth: '100%', maxHeight: 360 }} /><figcaption><p>Current alt text: {i.before || '(empty)'}</p><p><strong>Proposed alt text:</strong> {i.after || '(empty)'}</p></figcaption>{mode === 'deterministic' && <label>Edit proposed alt text<textarea maxLength={150} value={altEdits[i.source] ?? i.after ?? ''} disabled={busy} onChange={e => { setAltEdits(prev => ({ ...prev, [i.source]: e.target.value })); setReviewed(false); }} /></label>}</figure>)}
+      {!!Object.keys(altEdits).length && <button className="ui button" disabled={busy} onClick={() => act('revise-preview')}>Update reviewed description</button>}
+      {preview.diff && <pre className="rq-evidence" style={{ maxHeight: 360 }}>{preview.diff}</pre>}
+      <details><summary>Compare full page HTML</summary><h5>Current HTML</h5><pre className="rq-evidence">{preview.before_html}</pre><h5>Proposed HTML</h5><pre className="rq-evidence">{preview.after_html}</pre></details>
+      {(preview.fix_errors || []).length > 0 && <p>Some fixes failed: {JSON.stringify(preview.fix_errors)}</p>}
+      <label><input type="checkbox" checked={reviewed} disabled={busy} onChange={e => setReviewed(e.target.checked)} /> I reviewed this preview and want to {preview.kind === 'restore' ? 'restore this saved version' : 'apply these changes'}.</label>
+      <button className="ui primary button" disabled={busy || !!Object.keys(altEdits).length || !reviewed || preview.before_html === preview.after_html} onClick={() => act(preview.kind)}>{preview.kind === 'restore' ? 'Confirm restore and rescan' : 'Apply reviewed fix and rescan'}</button>
+    </div>}
+  </section>;
+}
