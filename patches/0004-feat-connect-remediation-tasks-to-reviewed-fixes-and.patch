+    bridge: async (action: string, body: any) => { calls.push({ action, body }); if (action === 'scan') { if (failScan) throw Error('down'); return { scanned_at: 'now', findings: [], wcag_review: { criteria: [{ id: '1.1.1', status: 'pass' }] } }; } return { applied: true, snapshot_path: '/data/snapshot.json' }; },
