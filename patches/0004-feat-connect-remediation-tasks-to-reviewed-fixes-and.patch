@@ -0,0 +1,26 @@
+/** Isolated deployment entry for the existing demo image. Normal builds mount
+ * the same component directly from ProjectAccessibility. */
+import React from 'react';
+import { createRoot, Root } from 'react-dom/client';
+import RemediationWorkQueue from './components/projects/RemediationWorkQueue';
+
+let root: Root | undefined;
+let host: HTMLDivElement | undefined;
+let project = '';
+let pending = false;
+function sync() {
+  pending = false;
+  const id = location.pathname.match(/^\/projects\/([^/]+)\/accessibility\/?$/)?.[1] || '';
+  const anchor = document.querySelector('.wcag-summary-segment');
+  if (root && (!host?.isConnected || id !== project || !anchor)) {
+    root.unmount(); host?.remove(); root = undefined; host = undefined;
+  }
+  if (!id || !anchor || root || document.querySelector('.remediation-work-queue')) return;
+  host = document.createElement('div');
+  anchor.after(host); project = id;
+  root = createRoot(host); root.render(<RemediationWorkQueue projectID={decodeURIComponent(id)} />);
+}
+new MutationObserver(() => {
+  if (!pending) { pending = true; requestAnimationFrame(sync); }
+}).observe(document.body, { childList: true, subtree: true });
+sync();
