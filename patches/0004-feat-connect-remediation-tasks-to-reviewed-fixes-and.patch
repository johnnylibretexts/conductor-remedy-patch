+import test from 'node:test';
+import assert from 'node:assert/strict';
+import express from 'express';
+import { registerRemediationQueue } from '../api/remediationqueue.js';
+import { queueCandidates, validateQueueUpdate } from './remediationqueue.js';
+
+const section = { _id: 'section1', pageID: '4218', sectionTitle: 'Test page', sectionURL: 'https://dev.libretexts.org/Sandboxes/johnnyphung/test', wcagReview: { scannedAt: '2026-09-13', criteria: [
+  { id: '1.1.1', title: 'Non-text content', status: 'fail', evidence: [{ findingId: 'img-alt#0', ruleId: 'img-alt', selector: 'img:first-child', message: 'Missing alt', snippet: '<img>' }] },
+  { id: '2.1.1', title: 'Keyboard', status: 'manual_review' },
+] } };
+
+test('candidate identity survives finding index and timestamp changes', () => {
+  const next = structuredClone(section);
+  next.wcagReview.scannedAt = '2026-10-01';
+  next.wcagReview.criteria[0].evidence![0].findingId = 'img-alt#27';
+  assert.equal(queueCandidates(section)[0].key, queueCandidates(next)[0].key);
+  assert.equal(queueCandidates(section)[1].kind, 'manual');
+});
+
+test('verification needs evidence and assignment must be to a project member', () => {
+  const base = { version: 0, status: 'verified', priority: 'normal', assignee: 'alice', note: '' };
+  assert.throws(() => validateQueueUpdate(base, ['alice']), /verification evidence/);
+  assert.throws(() => validateQueueUpdate({ ...base, note: 'tested', assignee: 'outsider' }, ['alice']), /team member/);
+  assert.equal(validateQueueUpdate({ ...base, note: 'Keyboard test passed' }, ['alice']).status, 'verified');
+});
+
+async function harness(run: (url: string, rows: any[]) => Promise<void>) {
+  const rows: any[] = [];
+  const project = { projectID: 'demo', members: ['alice', 'bob'], auditors: ['auditor'], a11yReview: [section] };
+  const WorkItems = {
+    find: ({ projectID }: any) => ({ sort: () => ({ lean: async () => rows.filter(r => r.projectID === projectID) }) }),
+    bulkWrite: async (ops: any[]) => {
+      let upsertedCount = 0;
+      for (const { updateOne: o } of ops) if (!rows.some(r => r.projectID === o.filter.projectID && r.key === o.filter.key)) {
+        rows.push({ ...o.update.$setOnInsert, _id: '012345678901234567890123' }); upsertedCount++;
+      }
+      return { upsertedCount };
+    },
+    findOneAndUpdate: (filter: any, update: any) => ({ lean: async () => {
+      const row = rows.find(r => r._id === filter._id && r.projectID === filter.projectID && r.version === filter.version);
+      if (!row) return null;
+      Object.assign(row, update.$set); row.version++; row.history.push(update.$push.history); return row;
+    } }),
+  };
+  const app = express(); app.use(express.json());
+  registerRemediationQueue(app, {
+    auth: { verifyRequest: (req: any, res: any, next: any) => { if (!req.headers['x-user']) return res.sendStatus(401); req.user = { decoded: { uuid: req.headers['x-user'] } }; next(); }, getUserAttributes: (_r: any, _s: any, n: any) => n(), checkHasRole: () => false },
+    projects: { checkProjectMemberPermission: (p: any, u: any) => [...p.members, ...p.auditors].includes(u.decoded.uuid) },
+    Project: { findOne: (q: any) => ({ lean: async () => q.projectID === 'demo' ? project : null }) },
+    User: { find: () => ({ select: () => ({ lean: async () => [{ uuid: 'alice', firstName: 'Alice' }, { uuid: 'bob', firstName: 'Bob' }] }) }) }, WorkItems,
+  });
+  const server = app.listen(0, '127.0.0.1');
+  await new Promise<void>(r => server.once('listening', r));
+  try { await run(`http://127.0.0.1:${(server.address() as any).port}/project/demo/accessibility/workqueue`, rows); }
+  finally { await new Promise<void>(r => server.close(() => r())); }
+}
+const send = (url: string, method = 'GET', body?: any, user = 'alice') => fetch(url, { method, headers: { 'Content-Type': 'application/json', ...(user ? { 'x-user': user } : {}) }, ...(body ? { body: JSON.stringify(body) } : {}) });
+
+test('API blocks unauthenticated users, outsiders, and auditor writes', async () => harness(async url => {
+  assert.equal((await send(url, 'GET', undefined, '')).status, 401);
+  assert.equal((await send(url, 'GET', undefined, 'outsider')).status, 403);
+  assert.equal((await send(url, 'POST', {}, 'auditor')).status, 403);
+  assert.equal((await send(url, 'GET', undefined, 'auditor')).status, 200);
+}));
+
