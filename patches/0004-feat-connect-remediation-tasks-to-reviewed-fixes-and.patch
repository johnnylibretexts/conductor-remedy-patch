+import { createHash } from 'node:crypto';
+
+export const queueStatuses = ['todo', 'in_progress', 'needs_review', 'verified', 'blocked'] as const;
+export const queuePriorities = ['low', 'normal', 'high', 'urgent'] as const;
+export function projectAssignees(project: any): string[] {
+  return [...new Set(['leads', 'liaisons', 'members'].flatMap(k => project[k] || [])
+    .map((x: any) => typeof x === 'string' ? x : x.uuid).filter(Boolean))] as string[];
+}
+
+/** Evidence keys deliberately exclude scan-local finding indexes and scan timestamps. */
+export function queueCandidates(section: any) {
+  const result: any[] = [];
+  for (const criterion of section.wcagReview?.criteria || []) {
+    if (!['fail', 'manual_review', 'not_tested'].includes(criterion.status)) continue;
+    const evidence = criterion.status === 'fail' && criterion.evidence?.length ? criterion.evidence : [null];
+    for (const e of evidence) {
+      const key = createHash('sha256').update(JSON.stringify([
+        section.pageID || section.sectionURL, criterion.id, e?.ruleId || criterion.status,
+        e?.selector || e?.message || '',
+      ])).digest('hex');
+      if (result.some(x => x.key === key)) continue;
+      result.push({ key, sectionID: String(section._id), pageID: section.pageID || '',
+        sectionTitle: section.sectionTitle, sectionURL: section.sectionURL,
+        criterionID: criterion.id, criterionTitle: criterion.title,
+        kind: e ? 'finding' : 'manual', ruleId: e?.ruleId || '', selector: e?.selector || '',
+        title: e?.message || `${criterion.id}: ${criterion.title} — manual verification`,
+        evidence: e?.snippet || criterion.applicabilityReason || '',
+        scannedAt: section.wcagReview?.scannedAt || null, fixable: Boolean(e?.fixable) });
+    }
+  }
+  return result;
+}
+
+export function validateQueueUpdate(body: any, assignees: string[]) {
+  if (!body || !Number.isInteger(body.version) || body.version < 0) throw Error('A valid item version is required.');
+  if (!queueStatuses.includes(body.status)) throw Error('Choose a valid status.');
+  if (!queuePriorities.includes(body.priority)) throw Error('Choose a valid priority.');
+  if (typeof body.assignee !== 'string' || (body.assignee && !assignees.includes(body.assignee))) throw Error('Assignee must be a current project team member.');
+  if (typeof body.note !== 'string' || body.note.length > 4000) throw Error('Notes must be at most 4,000 characters.');
+  if (body.status === 'verified' && !body.note.trim()) throw Error('Add verification evidence before marking this item verified.');
+  return { status: body.status, priority: body.priority, assignee: body.assignee, note: body.note.trim() };
+}
