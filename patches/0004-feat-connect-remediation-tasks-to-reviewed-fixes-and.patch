+  assert.equal((await (await send(url, 'POST', body)).json()).created, 1);
+  const patch = { version: 0, assignee: 'bob', status: 'in_progress', priority: 'high', note: 'Review description with author' };
+  assert.equal((await send(`${url}/${rows[0]._id}`, 'PATCH', patch)).status, 200);
+  assert.equal((await (await send(url, 'POST', body)).json()).created, 0);
+  assert.equal(rows.length, 1); assert.equal(rows[0].title, 'Missing alt');
+  assert.equal(rows[0].status, 'in_progress'); assert.equal(rows[0].history[1].note, patch.note);
+}));
+
+test('stale updates and cross-project IDs cannot overwrite an item', async () => harness(async (url, rows) => {
+  await send(url, 'POST', { sectionID: 'section1', keys: [queueCandidates(section)[0].key] });
+  const patch = { version: 0, assignee: '', status: 'needs_review', priority: 'normal', note: 'Ready' };
+  assert.equal((await send(`${url}/${rows[0]._id}`, 'PATCH', patch)).status, 200);
+  assert.equal((await send(`${url}/${rows[0]._id}`, 'PATCH', patch)).status, 409);
+  assert.equal((await send(`${url.replace('/demo/', '/other/')}/${rows[0]._id}`, 'PATCH', { ...patch, version: 1 })).status, 403);
+  assert.equal(rows[0].version, 1);
+}));
+
+test('verified updates require evidence and record the authenticated reviewer', async () => harness(async (url, rows) => {
+  await send(url, 'POST', { sectionID: 'section1', keys: [queueCandidates(section)[1].key] });
+  const patch = { version: 0, assignee: 'alice', status: 'verified', priority: 'normal', note: '' };
+  assert.equal((await send(`${url}/${rows[0]._id}`, 'PATCH', patch)).status, 400);
+  assert.equal((await send(`${url}/${rows[0]._id}`, 'PATCH', { ...patch, note: 'Keyboard-only traversal passed', verifiedBy: 'forged' })).status, 200);
+  assert.equal(rows[0].verifiedBy, 'alice');
+}));
