+import RemediationPageActions from './RemediationPageActions';
+import React, { useEffect, useRef, useState } from 'react';
+
+const statuses = { todo: 'To do', in_progress: 'In progress', needs_review: 'Needs review', verified: 'Verified', blocked: 'Blocked' };
+const priorities = ['low', 'normal', 'high', 'urgent'];
+const label = (s: string) => statuses[s as keyof typeof statuses] || s;
+
+async function request(path: string, method = 'GET', body?: unknown) {
+  const res = await fetch(`/api/v1${path}`, { method, credentials: 'same-origin',
+    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
+    ...(body ? { body: JSON.stringify(body) } : {}) });
+  const data = await res.json();
+  if (!res.ok || data.err) throw Error(data.errMsg || 'Unable to update the queue.');
+  return data;
+}
+
+function EditItem({ item, users, save, busy }: any) {
+  const [status, setStatus] = useState(item.status);
+  const [priority, setPriority] = useState(item.priority);
+  const [assignee, setAssignee] = useState(users.some((u: any) => u.uuid === item.assignee) ? item.assignee : '');
+  const [note, setNote] = useState('');
+  return <form onSubmit={e => { e.preventDefault(); save(item, { status, priority, assignee, note }); }}>
+    <div className="rq-fields">
+      <label>Status<select value={status} onChange={e => setStatus(e.target.value)}>{Object.entries(statuses).map(([v, title]) => <option key={v} value={v}>{title}</option>)}</select></label>
+      <label>Priority<select value={priority} onChange={e => setPriority(e.target.value)}>{priorities.map(v => <option key={v} value={v}>{v}</option>)}</select></label>
+      <label>Assigned to<select value={assignee} onChange={e => setAssignee(e.target.value)}><option value="">Unassigned</option>{users.map((u: any) => <option key={u.uuid} value={u.uuid}>{u.firstName} {u.lastName}</option>)}</select></label>
+    </div>
+    <label>Reviewer note / verification evidence<textarea value={note} maxLength={4000} rows={3} required={status === 'verified'} onChange={e => setNote(e.target.value)} placeholder="Record the proposed approach, review, or manual test result." /></label>
+    <p>Verified requires evidence. Changing status does not apply a fix or change the matrix score.</p>
+    <button className="ui primary button" disabled={busy} type="submit">Save work item</button>
+  </form>;
+}
+
+export default function RemediationWorkQueue({ projectID }: { projectID: string }) {
+  const [data, setData] = useState<any>({ items: [], users: [], sections: [], candidates: [] });
+  const [sectionID, setSectionID] = useState('');
+  const [chosen, setChosen] = useState<string[]>([]);
+  const [activePage, setActivePage] = useState<any>(null);
+  const [filter, setFilter] = useState('open');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [message, setMessage] = useState('');
+  const generation = useRef(0);
+  const base = `/project/${encodeURIComponent(projectID)}/accessibility/workqueue`;
+  async function load() {
+    const current = ++generation.current;
+    const next = await request(`${base}?sectionID=${encodeURIComponent(sectionID)}`);
+    if (current === generation.current) setData(next);
+  }
+  useEffect(() => {
+    setChosen([]); setError('');
+    load().catch(e => setError(e.message));
+    return () => { generation.current++; };
+  }, [projectID, sectionID]);
+  async function act(fn: () => Promise<any>, success: (r: any) => string) {
+    setBusy(true); setError(''); setMessage('');
+    try { const result = await fn(); await load(); setChosen([]); setMessage(success(result)); }
+    catch (e: any) { setError(e.message); }
+    finally { setBusy(false); }
+  }
+  const users = new Map(data.users.map((u: any) => [u.uuid, `${u.firstName} ${u.lastName}`]));
+  const existing = new Set(data.items.map((i: any) => i.key));
+  const items = data.items.filter((i: any) => filter === 'all' || (filter === 'open' ? i.status !== 'verified' : i.status === filter));
+  return <section className="ui segment remediation-work-queue" aria-label="Remediation work queue">
+    <style>{`.remediation-work-queue{margin:1.5rem 0!important}.remediation-work-queue h2{margin-top:0}.remediation-work-queue select,.remediation-work-queue textarea{display:block;padding:.55rem;border:1px solid #999;border-radius:4px;background:white;color:#222;max-width:100%;width:100%}.remediation-work-queue label{display:block;font-weight:600}.remediation-work-queue textarea{margin:.4rem 0}.rq-fields{display:flex;gap:1rem;flex-wrap:wrap;margin:1rem 0}.rq-fields label{flex:1;min-width:160px}.rq-candidates{max-height:260px;overflow:auto;margin:1rem 0;padding:.5rem;border:1px solid #ccc}.rq-candidates label{padding:.5rem;font-weight:normal}.rq-candidates input{margin-right:.6rem}.rq-table{overflow:auto}.rq-table table{min-width:640px}.rq-table td{vertical-align:top}.rq-table summary{cursor:pointer;font-weight:600;margin:.5rem 0}.rq-evidence{white-space:pre-wrap;overflow-wrap:anywhere;max-height:150px;overflow:auto}.rq-history{padding-left:1.3rem}.rq-history li{margin:.6rem 0}.remediation-work-queue :focus-visible{outline:3px solid #1565c0;outline-offset:2px}`}</style>
+    <h2>Remediation work queue</h2>
+    <p>Assign findings and manual checks, record progress, and keep reviewer notes across scans.</p>
+    <p><strong>{data.items.filter((i: any) => i.status !== 'verified').length} open</strong> · {data.items.filter((i: any) => i.status === 'verified').length} verified</p>
+    {error && <div role="alert" className="ui negative message">{error}</div>}
+    <div role="status" aria-live="polite">{message}</div>
+    {data.canEdit && <><label>Page tools<select value={activePage?.section.id || ''} onChange={e => { const section = data.sections.find((s: any) => s.id === e.target.value); setActivePage(section ? { section } : null); }}><option value="">Choose a page to fix or restore</option>{data.sections.map((s: any) => <option key={s.id} value={s.id}>{s.title}</option>)}</select></label></>}
+    {activePage && data.canEdit && <RemediationPageActions key={`${activePage.section.id}-${activePage.item?._id || ''}`} {...activePage} base={base} request={request} refreshed={load} close={() => setActivePage(null)} />}
+    {data.canEdit && <details><summary>Add work from a page review</summary>
+      <label>Page<select value={sectionID} disabled={busy} onChange={e => setSectionID(e.target.value)}><option value="">Choose a page</option>{data.sections.map((s: any) => <option key={s.id} value={s.id}>{s.title}</option>)}</select></label>
+      {sectionID && <><p>Choose findings or manual checks. Existing items are retained; adding again does not duplicate them.</p>
+        <div className="rq-candidates">{data.candidates.map((c: any) => <label key={c.key}><input type="checkbox" disabled={busy || existing.has(c.key)} checked={existing.has(c.key) || chosen.includes(c.key)} onChange={e => setChosen(prev => e.target.checked ? [...prev, c.key] : prev.filter(k => k !== c.key))} />{c.criterionID} · {c.title} {existing.has(c.key) && '(already queued)'}</label>)}{!data.candidates.length && <p>No stored failed or manual criteria. Scan this page first.</p>}</div>
+        <button type="button" className="ui primary button" disabled={busy || !chosen.length || chosen.length > 100} onClick={() => act(() => request(base, 'POST', { sectionID, keys: chosen }), r => `${r.created} work item(s) added.`)}>Add selected ({chosen.length})</button></>}
+    </details>}
+    <div className="rq-fields"><label>Show<select value={filter} onChange={e => setFilter(e.target.value)}><option value="open">All open items</option><option value="all">All items</option>{Object.entries(statuses).map(([v, title]) => <option key={v} value={v}>{title}</option>)}</select></label><div><button type="button" className="ui button" disabled={busy} onClick={() => act(() => Promise.resolve(), () => 'Queue refreshed.')}>Refresh queue</button></div></div>
+    {!items.length ? <p>No work items in this view.</p> : <div className="rq-table"><table className="ui celled table"><thead><tr><th>Page and finding</th><th>Assignment</th><th>Progress and review</th></tr></thead><tbody>{items.map((item: any) => <tr key={item._id}>
+      <td><strong>{item.sectionTitle}</strong>{data.canEdit && <p><button type="button" className="ui button" onClick={() => setActivePage({ section: { id: item.sectionID, title: item.sectionTitle }, item })}>Fix and rescan task</button></p>}<p>{item.criterionID} · {item.title}</p>{/^https:\/\//.test(item.sectionURL) && <a href={item.sectionURL} target="_blank" rel="noopener noreferrer">Open source page</a>}<details><summary>Original scan evidence</summary><p>{item.ruleId} {item.selector}</p><pre className="rq-evidence">{item.evidence}</pre><p>Captured: {item.scannedAt ? new Date(item.scannedAt).toLocaleString() : 'Not recorded'}. Evidence may change after a rescan; verification is explicit.</p></details></td>
+      <td>{String(users.get(item.assignee) || (item.assignee ? 'Former team member' : 'Unassigned'))}<p>Priority: {item.priority}</p></td>
+      <td><strong>{label(item.status)}</strong>{!!item.scanEvidence?.length && <details><summary>Scan evidence ({item.scanEvidence.length})</summary><ol className="rq-history">{item.scanEvidence.map((e: any, n: number) => <li key={n}><strong>{e.action}</strong> · {new Date(e.at).toLocaleString()}<p>Criterion result: {e.criterion?.status || 'Not available'}. Matching findings: {e.findings?.length ?? 'Not available'}.</p>{e.scanError && <p>{e.scanError}</p>}<details><summary>Evidence details</summary><pre className="rq-evidence">{JSON.stringify(e, null, 2)}</pre></details></li>)}</ol></details>}<details><summary>History ({item.history.length})</summary><ol className="rq-history">{item.history.map((h: any, n: number) => <li key={n}>{new Date(h.at).toLocaleString()} · {String(users.get(h.actor) || h.actor)} · {label(h.status)}<p>{h.note}</p></li>)}</ol></details>
+      {data.canEdit && <details key={`${item._id}-${item.version}`}><summary>Edit work item</summary><EditItem item={item} users={data.users} busy={busy} save={(i: any, fields: any) => act(() => request(`${base}/${i._id}`, 'PATCH', { ...fields, version: i.version }), () => 'Work item saved.')} /></details>}</td>
+    </tr>)}</tbody></table></div>}
+  </section>;
+}
