+import mongoose from 'mongoose';
+import { registerRemediationActions } from './remediationactions.js';
+import { queueCandidates, projectAssignees, validateQueueUpdate, queueStatuses, queuePriorities } from '../util/remediationqueue.js';
+
+const schema = new mongoose.Schema({
+  projectID: { type: String, required: true }, key: { type: String, required: true },
+  sectionID: String, pageID: String, sectionTitle: String, sectionURL: String,
+  criterionID: String, criterionTitle: String, kind: String, ruleId: String,
+  selector: String, title: String, evidence: String, scannedAt: String, fixable: Boolean,
+  status: { type: String, enum: queueStatuses, default: 'todo' },
+  priority: { type: String, enum: queuePriorities, default: 'normal' },
+  assignee: { type: String, default: '' }, version: { type: Number, default: 0 },
+  scanEvidence: [mongoose.Schema.Types.Mixed],
+  createdBy: String, verifiedBy: String, verifiedAt: Date,
+  history: [{ actor: String, at: Date, status: String, priority: String, assignee: String, note: String }],
+}, { timestamps: true });
+schema.index({ projectID: 1, key: 1 }, { unique: true });
+const WorkItem = mongoose.models.RemediationWorkItem || mongoose.model('RemediationWorkItem', schema);
+
+/** Dependencies are injected so this module also layers onto the existing deployed bundle. */
+export function registerRemediationQueue(router: any, { auth, projects, Project, User, WorkItems = WorkItem, bridge }: any) {
+  const base = '/project/:projectID/accessibility/workqueue';
+  const authorize = async (req: any, res: any, next: any) => {
+    try {
+      if (!/^[\w-]{1,100}$/.test(req.params.projectID)) return res.status(400).json({ err: true, errMsg: 'Invalid project.' });
+      const project = await Project.findOne({ projectID: req.params.projectID }).lean();
+      if (!project || !projects.checkProjectMemberPermission(project, req.user)) return res.status(403).json({ err: true, errMsg: 'Project team access required.' });
+      req.queueCanEdit = projectAssignees(project).includes(req.user.decoded.uuid) || auth.checkHasRole(req.user, 'libretexts', ['superadmin', 'support']);
+      if (req.method !== 'GET' && !req.queueCanEdit) return res.status(403).json({ err: true, errMsg: 'Project editing permission required.' });
+      req.queueProject = project;
+      next();
+    } catch { res.status(500).json({ err: true, errMsg: 'Unable to load the work queue.' }); }
+  };
+  const access = [auth.verifyRequest, auth.getUserAttributes, authorize];
+  registerRemediationActions(router, { base, access, Project, WorkItems, bridge });
+  router.get(base, ...access, async (req: any, res: any) => {
+    try {
+      const sections = req.queueProject.a11yReview || [];
+      const selected = sections.find((s: any) => String(s._id) === req.query.sectionID);
+      const users = await User.find({ uuid: { $in: projectAssignees(req.queueProject) } }).select('uuid firstName lastName -_id').lean();
+      const items = await WorkItems.find({ projectID: req.params.projectID }).sort({ createdAt: -1 }).lean();
+      res.json({ err: false, canEdit: req.queueCanEdit, items, users, sections: sections.map((s: any) => ({ id: String(s._id), title: s.sectionTitle })), candidates: selected ? queueCandidates(selected) : [] });
+    } catch { res.status(500).json({ err: true, errMsg: 'Unable to load the work queue.' }); }
+  });
+  router.post(base, ...access, async (req: any, res: any) => {
+    try {
+      const { sectionID, keys } = req.body || {};
+      const section = (req.queueProject.a11yReview || []).find((s: any) => String(s._id) === sectionID);
+      if (!section || !Array.isArray(keys) || !keys.length || keys.length > 100 || keys.some(k => typeof k !== 'string')) return res.status(400).json({ err: true, errMsg: 'Choose 1–100 findings from a current page review.' });
+      const candidates = queueCandidates(section), chosen = candidates.filter(x => keys.includes(x.key));
+      if (chosen.length !== new Set(keys).size) return res.status(409).json({ err: true, errMsg: 'Review changed. Refresh the available findings.' });
+      const actor = req.user.decoded.uuid;
+      const result = await WorkItems.bulkWrite(chosen.map(item => ({ updateOne: {
+        filter: { projectID: req.params.projectID, key: item.key },
+        update: { $setOnInsert: { ...item, projectID: req.params.projectID, status: 'todo', priority: 'normal', assignee: '', version: 0, createdBy: actor,
+          history: [{ actor, at: new Date(), status: 'todo', priority: 'normal', assignee: '', note: 'Added from accessibility review.' }] } }, upsert: true,
+      } })), { ordered: false });
+      res.json({ err: false, created: result.upsertedCount });
+    } catch (e: any) {
+      if (e.code === 11000) return res.json({ err: false, created: 0 });
+      res.status(500).json({ err: true, errMsg: 'Unable to add work items.' });
+    }
+  });
+  router.patch(`${base}/:itemID`, ...access, async (req: any, res: any) => {
+    let changes;
+    try {
+      if (!mongoose.isValidObjectId(req.params.itemID)) throw Error('Invalid work item.');
+      changes = validateQueueUpdate(req.body, projectAssignees(req.queueProject));
+    } catch (e: any) { return res.status(400).json({ err: true, errMsg: e.message }); }
+    try {
+      const actor = req.user.decoded.uuid, at = new Date();
+      const { note, ...fields } = changes;
+      const item = await WorkItems.findOneAndUpdate({ _id: req.params.itemID, projectID: req.params.projectID, version: req.body.version }, {
+        $set: { ...fields, verifiedBy: fields.status === 'verified' ? actor : '', verifiedAt: fields.status === 'verified' ? at : null },
+        $inc: { version: 1 }, $push: { history: { actor, at, ...changes } },
+      }, { new: true, runValidators: true }).lean();
+      if (!item) return res.status(409).json({ err: true, errMsg: 'Item changed or is unavailable. Refresh before saving.' });
+      res.json({ err: false, item });
+    } catch { res.status(500).json({ err: true, errMsg: 'Unable to update this work item.' }); }
+  });
+}
