+const now=Date.now(),at=new Date(now).toISOString(),scope={version:'scope-1',boundaries:'All full reader pages',processes:'Read and navigate the complete book'};
+function section(){return {_id:'page-1',sectionURL:'https://dev.libretexts.org/Sandboxes/johnnyphung/book',wcagReview:{sourceHash:'source',scannedAt:at,criteria:criteria.map(c=>({...c,status:'pass'})),rendered:{state:'complete',sourceHash:'source',renderedHash:'rendered',platformHash:'platform',browser:'chromium',axeVersion:'4',scannedAt:at,violations:[]}}};}
+test('automated 100 percent never establishes verification or sign-off',()=>{
+ const report=conformanceReport({projectID:'book',a11yReview:[section()]},scope,[],[],now);
+ assert.equal(report.totalCriteria,50);assert.equal(report.verifiedCriteria,0);assert.equal(report.readyForSignoff,false);
+ assert.equal(report.status,'verification_pending');
+});
+test('missing pages, source changes, failed loads, stale scans and failures block conformance',()=>{
+ assert.ok(scanBlockers({}).length);
+ for(const mutate of [(s:any)=>s.wcagReview.sourceHash='changed',(s:any)=>s.wcagReview.rendered.state='incomplete',(s:any)=>s.wcagReview.rendered.scannedAt='2020-01-01',(s:any)=>s.wcagReview.criteria[0].status='fail',(s:any)=>s.wcagReview.criteria.pop()]){const s=section();mutate(s);assert.ok(scanBlockers(s,now).length);}
+});
+test('all criteria need evidence bound to current content, platform and scope',()=>{
+ const s=section(),fingerprint=pageFingerprint(s),reviews=criteria.map(c=>({_id:c.id,sectionID:'page-1',criterionID:c.id,status:'pass',fingerprint,scopeVersion:scope.version}));
+ const r=conformanceReport({a11yReview:[s]},scope,reviews,[],now);assert.equal(r.readyForSignoff,true);assert.equal(r.status,'verification_pending');
+ assert.equal(conformanceReport({a11yReview:[s]},scope,reviews,[{digest:r.digest}],now).status,'verified_for_evaluated_scope');
+ s.wcagReview.rendered.platformHash='new css';
+ assert.equal(conformanceReport({a11yReview:[s]},scope,reviews,[{digest:r.digest}],now).verifiedCriteria,0);
+ assert.equal(conformanceReport({a11yReview:[section()]},{...scope,version:'new scope'},reviews,[],now).verifiedCriteria,0);
+ assert.equal(conformanceReport({a11yReview:[section(),{_id:'unscanned'}]},scope,reviews,[],now).readyForSignoff,false);
+});
+test('review validates actual checklists, evidence, N/A rationale and concurrency token',()=>{
+ const s=section(),body={criterionID:'1.1.1',fingerprint:pageFingerprint(s),scopeVersion:scope.version,status:'pass',notes:'Observed the equation with a screen reader and compared its structure.',environment:'NVDA / Windows / Firefox version recorded',evidenceURLs:[],checks:[0,1],confirmed:true};
+ assert.equal(validateReview(body,s,scope).status,'pass');
+ for(const patch of [{checks:[]},{confirmed:false},{notes:'ok'},{fingerprint:'old'},{scopeVersion:'old'},{evidenceURLs:['javascript:alert(1)']},{status:'not_applicable',reason:''}])assert.throws(()=>validateReview({...body,...patch},s,scope));
+});
