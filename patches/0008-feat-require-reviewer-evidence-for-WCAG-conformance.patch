+++ b/server/util/conformance.ts
@@ -0,0 +1,60 @@
+import { createHash } from 'node:crypto';
+import criteria from './conformanceCriteria.json';
+export { criteria };
+export const MAX_EVIDENCE_AGE_MS = 24 * 60 * 60 * 1000;
+const hash = (x: unknown) => createHash('sha256').update(JSON.stringify(x)).digest('hex');
+export function pageFingerprint(section: any) {
+  const w = section.wcagReview, r = w?.rendered;
+  if (!w?.sourceHash || r?.sourceHash !== w.sourceHash || !r?.renderedHash || !r?.platformHash) return null;
+  return hash([section.sectionURL,w.sourceHash,r.renderedHash,r.platformHash,r.browser,r.axeVersion]);
+}
+export function scanBlockers(section: any, now = Date.now()) {
+  const w = section.wcagReview, r = w?.rendered, blockers: string[] = [];
+  if (!pageFingerprint(section)) blockers.push('Current source and rendered evidence required.');
+  if (r?.state !== 'complete') blockers.push('Rendered-page scan is missing, failed or incomplete.');
+  if (![r?.scannedAt,w?.scannedAt].every(t=> typeof t === 'string' && Number.isFinite(Date.parse(t)) && Date.parse(t) <= now + 60000 && now-Date.parse(t) <= MAX_EVIDENCE_AGE_MS)) blockers.push('Rescan required: evidence is older than 24 hours or missing.');
+  if (!Array.isArray(w?.criteria) || criteria.some(c=>!w.criteria.some((x:any)=>x.id===c.id))) blockers.push('All 50 WCAG 2.1 A/AA criteria must be present.');
+  if (w?.criteria?.some((c:any)=>c.status==='fail') || r?.violations?.length) blockers.push('Unresolved automated failures.');
+  if (section.remedyError) blockers.push('Latest page scan reported an error.');
+  return blockers;
+}
+export function validateReview(body:any, section:any, scope:any) {
+  const criterion = criteria.find(c=>c.id===body?.criterionID);
+  if (!criterion || !scope?.version) throw Error('Select a criterion and define the evaluation scope first.');
+  const fingerprint=pageFingerprint(section);
+  if (!fingerprint || fingerprint!==body.fingerprint || body.scopeVersion!==scope.version) throw Error('Evidence or scope changed. Refresh before saving.');
+  if (!['pass','fail','not_applicable'].includes(body.status)) throw Error('Choose a review outcome.');
+  if (typeof body.notes!=='string' || body.notes.trim().length<20 || body.notes.length>12000) throw Error('Provide specific review evidence (20–12,000 characters).');
+  if (typeof body.environment!=='string' || body.environment.trim().length<5 || body.environment.length>1000) throw Error('Record browser, operating system, assistive technology and versions.');
+  if (!Array.isArray(body.evidenceURLs) || body.evidenceURLs.length>20 || body.evidenceURLs.some((x:any)=>typeof x!=='string' || x.length>2000 || !/^https:\/\/[^\s]+$/.test(x))) throw Error('Evidence references must be HTTPS URLs (up to 20).');
+  if (body.status==='not_applicable' && (typeof body.reason!=='string' || body.reason.trim().length<20 || body.reason.length>4000)) throw Error('Explain why this criterion does not apply to the full evaluated scope.');
+  if (!Array.isArray(body.checks) || criterion.checklist.some((_,i)=>!body.checks.includes(i)) || body.confirmed!==true) throw Error('Complete the criterion checklist and confirm your review.');
+  if (body.status!=='fail' && scanBlockers(section).length) throw Error('Resolve scan blockers and obtain fresh evidence before passing a criterion.');
+  return {criterionID:criterion.id,status:body.status,notes:body.notes.trim(),environment:body.environment.trim(),
+    evidenceURLs:body.evidenceURLs,reason:body.status==='not_applicable'?body.reason.trim():'',checks:criterion.checklist,
+    fingerprint,scopeVersion:scope.version};
+}
+export function conformanceReport(project:any, scope:any, reviews:any[], signoffs:any[], now=Date.now()) {
+  const sections=project.a11yReview || [];
+  let verified=0;
+  const pages=sections.map((s:any)=>{
+    const fingerprint=pageFingerprint(s), blockers=scanBlockers(s,now);
+    const results=criteria.map(c=>{
+      const candidates=reviews.filter(r=>String(r.sectionID)===String(s._id) && r.criterionID===c.id);
+      const current=candidates.find(r=>r.fingerprint===fingerprint && r.scopeVersion===scope?.version);
+      const status=current ? current.status : candidates.length?'stale':'unreviewed';
+      if (!blockers.length && ['pass','not_applicable'].includes(status)) verified++;
+      return {...c,status,review:current || null};
+    });
+    return {sectionID:String(s._id),title:s.sectionTitle,url:s.sectionURL,fingerprint,blockers,criteria:results,
+      sourceScan:s.wcagReview || null};
+  });
+  const total=sections.length*criteria.length;
+  const ready=Boolean(scope?.version && scope?.processes?.trim() && scope?.boundaries?.trim() && total && verified===total);
+  const digest=hash({scopeVersion:scope?.version,pages:pages.map((p:any)=>[p.sectionID,p.fingerprint,p.criteria.map((c:any)=>String(c.review?._id || ''))])});
+  const signoff=ready ? signoffs.find(s=>s.digest===digest) : null;
+  return {standard:'WCAG 2.1 Level AA',generatedAt:new Date(now).toISOString(),projectID:project.projectID,
+    scope:scope || null,pages,totalCriteria:total,verifiedCriteria:verified,verificationPercent:total?Math.floor(verified/total*100):0,
+    readyForSignoff:ready,status:signoff?'verified_for_evaluated_scope':'verification_pending',signoff:signoff || null,digest,
+    limitations:'Automated checks are not certification. Verification is a dated reviewer assertion for the listed full pages and complete processes. Evidence expires after 24 hours without revalidation; content, rendering or scope changes invalidate reviews. Legal exceptions do not establish WCAG conformance.'};
+}
