+test('conformance API binds reviewer identity, rejects forged/stale evidence and premature sign-off',async()=>{
+ const records:any[]=[{kind:'scope',data:{version:'scope1',boundaries:'Full reader pages',processes:'Read and navigate'}}],at=new Date().toISOString();
+ const section={_id:'p1',sectionURL:'https://dev.libretexts.org/Sandboxes/johnnyphung/Test',wcagReview:{sourceHash:'a',scannedAt:at,criteria:criteria.map(c=>({...c,status:'pass'})),rendered:{sourceHash:'a',renderedHash:'b',platformHash:'c',scannedAt:at,state:'complete',violations:[]}}};
+ const app=express();app.use(express.json());
+ registerConformance(app,{base:'/q',access:[(req:any,res:any,next:any)=>{if(req.headers['x-user']!=='reviewer')return res.sendStatus(403);req.user={decoded:{uuid:'reviewer'}};req.queueCanEdit=true;req.queueProject={projectID:'demo',a11yReview:[section]};req.params.projectID='demo';next();}],Records:{find:()=>({sort:()=>({lean:async()=>records})}),create:async(r:any)=>records.unshift(r)}});
+ const server=app.listen(0,'127.0.0.1');await new Promise<void>(r=>server.once('listening',r));const base=`http://127.0.0.1:${(server.address() as any).port}/q/conformance`;
+ const post=(action:string,body:any,user='reviewer')=>fetch(`${base}/${action}`,{method:'POST',headers:{'Content-Type':'application/json','x-user':user},body:JSON.stringify(body)});
+ try{
+  assert.equal((await post('review',{},'outsider')).status,403);
+  assert.equal((await post('signoff',{confirmed:true,digest:'forged',statement:'All of the book pages have supposedly passed the review.'})).status,400);
+  const body={sectionID:'p1',criterionID:'1.1.1',fingerprint:pageFingerprint(section),scopeVersion:'scope1',status:'pass',notes:'Compared mathematical meaning with screen reader output and visual content.',environment:'OS / Browser / Screen reader versions',evidenceURLs:[],checks:[0,1],confirmed:true,actor:'forged'};
+  assert.equal((await post('review',{...body,fingerprint:'forged'})).status,400);
+  assert.equal((await post('review',body)).status,200);assert.equal(records[0].actor,'reviewer');assert.equal(records[0].data.actor,undefined);
+ }finally{await new Promise<void>(r=>server.close(()=>r()));}
+});
