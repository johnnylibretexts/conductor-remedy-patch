+import mongoose from 'mongoose';
+import { randomUUID } from 'node:crypto';
+import { criteria, conformanceReport, validateReview } from '../util/conformance.js';
+const recordSchema = new mongoose.Schema({projectID:String,sectionID:String,criterionID:String,kind:String,
+  fingerprint:String,scopeVersion:String,status:String,actor:String,at:Date,data:mongoose.Schema.Types.Mixed}, {timestamps:true});
+recordSchema.index({projectID:1,kind:1,createdAt:-1});
+const Record = mongoose.models.ConformanceRecord || mongoose.model('ConformanceRecord',recordSchema);
+export function registerConformance(router:any,{base,access,Records=Record}:any) {
+  const load=async(project:any)=>{
+    const records=await Records.find({projectID:project.projectID}).sort({createdAt:-1,_id:-1}).lean();
+    const scope=records.find((r:any)=>r.kind==='scope')?.data;
+    const reviews=records.filter((r:any)=>r.kind==='review').map((r:any)=>({...r.data,_id:r._id,sectionID:r.sectionID,actor:r.actor,at:r.at}));
+    const signoffs=records.filter((r:any)=>r.kind==='signoff').map((r:any)=>({...r.data,actor:r.actor,at:r.at}));
+    return {scope,report:conformanceReport(project,scope,reviews,signoffs)};
+  };
+  router.get(`${base}/conformance`,...access,async(req:any,res:any)=>{
+    try {const {report}=await load(req.queueProject);res.json({err:false,canEdit:req.queueCanEdit,criteria,report});}
+    catch {res.status(500).json({err:true,errMsg:'Unable to load conformance evidence.'});}
+  });
+  router.post(`${base}/conformance/:action`,...access,async(req:any,res:any)=>{
+    try {
+      const {scope,report}=await load(req.queueProject), body=req.body || {};
+      let kind=req.params.action,data:any,sectionID='',criterionID='';
+      if(kind==='scope') {
+        for(const key of ['boundaries','processes','platformVersion']) if(typeof body[key]!=='string' || body[key].trim().length<10 || body[key].length>12000) throw Error('Define full-page boundaries, complete processes/states and the platform version (10–12,000 characters each).');
+        if(body.confirmed!==true) throw Error('Confirm the scope includes full pages, embedded content and complete processes.');
+        data={version:randomUUID(),boundaries:body.boundaries.trim(),processes:body.processes.trim(),platformVersion:body.platformVersion.trim(),standard:'WCAG 2.1 Level AA',definedBy:req.user.decoded.uuid,definedAt:new Date().toISOString()};
+      } else if(kind==='review') {
+        const section=(req.queueProject.a11yReview || []).find((s:any)=>String(s._id)===body.sectionID);
+        if(!section) throw Error('Page is not in this project.');
+        data=validateReview(body,section,scope);sectionID=body.sectionID;criterionID=data.criterionID;
+      } else if(kind==='signoff') {
+        if(!report.readyForSignoff || report.digest!==body.digest) throw Error('All pages and criteria require current verified evidence before sign-off.');
+        if(body.confirmed!==true || typeof body.statement!=='string' || body.statement.trim().length<40 || body.statement.length>4000) throw Error('Provide and confirm a reviewer conformance statement (40–4,000 characters).');
+        data={digest:report.digest,scopeVersion:scope.version,statement:body.statement.trim()};
+      } else throw Error('Unknown conformance action.');
+      await Records.create({projectID:req.params.projectID,kind,sectionID,criterionID,actor:req.user.decoded.uuid,at:new Date(),data});
+      res.json({err:false});
+    } catch(e:any) {res.status(400).json({err:true,errMsg:e.message || 'Unable to save conformance evidence.'});}
+  });
+}
