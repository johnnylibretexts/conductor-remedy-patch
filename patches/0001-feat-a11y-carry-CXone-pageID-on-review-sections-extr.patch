+/// <reference types="node" />
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import {
+  buildA11YReviewSectionsFromTOC,
+  mergeA11YReviewSectionsFromTOC,
+} from "./a11yreviewutils";
+
+test("buildA11YReviewSectionsFromTOC flattens every descendant page in TOC order", () => {
+  const toc = {
+    id: "4307",
+    title: "Chemistry - The Central Science",
+    url: "https://dev.libretexts.org/Sandboxes/remedy-test/chemistry_central",
+    children: [
+      {
+        id: "4308",
+        title: "01: Introduction - Matter and Measurement",
+        url: "https://dev.libretexts.org/Sandboxes/remedy-test/chemistry_central/01%3A_Introduction",
+        children: [
+          {
+            id: 4313,
+            title: "1.01: Studying Chemistry",
+            url: "https://dev.libretexts.org/Sandboxes/remedy-test/chemistry_central/01%3A_Introduction/1.01%3A_Studying_Chemistry",
+          },
+          {
+            "@id": "4314",
+            title: "1.02: Classification of Matter",
+            url: "https://dev.libretexts.org/Sandboxes/remedy-test/chemistry_central/01%3A_Introduction/1.02%3A_Classification_of_Matter",
+          },
+        ],
+      },
+      {
+        id: "4309",
+        title: "02: Atoms, Molecules, and Ions",
+        url: "https://dev.libretexts.org/Sandboxes/remedy-test/chemistry_central/02%3A_Atoms",
+        children: [],
+      },
+    ],
+  };
+
+  const sections = buildA11YReviewSectionsFromTOC(toc);
+
+  assert.deepEqual(
+    sections.map((section) => section.sectionTitle),
+    [
+      "01: Introduction - Matter and Measurement",
+      "1.01: Studying Chemistry",
+      "1.02: Classification of Matter",
+      "02: Atoms, Molecules, and Ions",
+    ],
+  );
+  assert.deepEqual(
+    sections.map((section) => section.pageID),
+    ["4308", "4313", "4314", "4309"],
+  );
+});
+
+test("buildA11YReviewSectionsFromTOC skips malformed TOC entries without mutating the source", () => {
+  const child = {
+    id: "1",
+    title: "Valid",
+    url: "https://dev.libretexts.org/Sandboxes/remedy-test/valid",
+    children: [
+      { title: "", url: "https://dev.libretexts.org/Sandboxes/remedy-test/empty-title" },
+      { title: "Missing URL" },
+    ],
+  };
+  const toc = {
+    title: "Root",
+    url: "https://dev.libretexts.org/Sandboxes/remedy-test/root",
+    children: [child],
+  };
+
+  const sections = buildA11YReviewSectionsFromTOC(toc);
+
+  assert.equal(sections.length, 1);
+  assert.equal(sections[0].sectionTitle, "Valid");
+  assert.equal(child.children.length, 2);
+});
+
+test("mergeA11YReviewSectionsFromTOC preserves scan state while refreshing title, URL, and page ID", () => {
+  const existingSections = [
+    {
+      _id: "existing-one",
+      sectionTitle: "Old Chapter Title",
+      sectionURL: "https://dev.libretexts.org/Sandboxes/remedy-test/chemistry_central/01",
+      pageID: "old-page-id",
+      imgAltText: true,
+      wcagReview: { summary: { score: 88 } },
+      dojExceptions: [{ id: "exception-1", status: "verified" }],
+    },
+    {
+      _id: "existing-two",
+      sectionTitle: "1.01: Studying Chemistry",
+      sectionURL: "https://dev.libretexts.org/Sandboxes/remedy-test/old-studying-chemistry",
+      linkNoneEmpty: false,
+    },
+  ];
+  const tocSections = [
+    {
+      sectionTitle: "01: Introduction - Matter and Measurement",
+      sectionURL: "https://dev.libretexts.org/Sandboxes/remedy-test/chemistry_central/01",
+      pageID: "4308",
+    },
+    {
+      sectionTitle: "1.01: Studying Chemistry",
+      sectionURL: "https://dev.libretexts.org/Sandboxes/remedy-test/chemistry_central/01/1.01",
+      pageID: "4313",
+    },
+    {
+      sectionTitle: "1.02: Classification of Matter",
+      sectionURL: "https://dev.libretexts.org/Sandboxes/remedy-test/chemistry_central/01/1.02",
+      pageID: "4314",
+    },
+  ];
+
+  const merged = mergeA11YReviewSectionsFromTOC(tocSections, existingSections);
+
+  assert.equal(merged.length, 3);
+  assert.equal(merged[0]._id, "existing-one");
+  assert.equal(merged[0].sectionTitle, "01: Introduction - Matter and Measurement");
+  assert.equal(merged[0].pageID, "4308");
+  assert.deepEqual(merged[0].wcagReview, { summary: { score: 88 } });
+  assert.deepEqual(merged[0].dojExceptions, [{ id: "exception-1", status: "verified" }]);
+  assert.equal(merged[1]._id, "existing-two");
+  assert.equal(merged[1].sectionURL, "https://dev.libretexts.org/Sandboxes/remedy-test/chemistry_central/01/1.01");
+  assert.equal(merged[1].linkNoneEmpty, false);
+  assert.equal(merged[2]._id, undefined);
+});
