@@ -91,3 +101,97 @@ const a11ySectionReviewItems = [
 export const validateA11YReviewSectionItem = (item: string) => {
     return a11ySectionReviewItems.includes(item);
 }
+
+type TocPage = {
+    id?: string | number;
+    '@id'?: string | number;
+    title?: string;
+    url?: string;
+    children?: TocPage[];
+    subpages?: TocPage[] | "";
+};
+
+export type A11YReviewSectionFromTOC = {
+    sectionTitle: string;
+    sectionURL: string;
+    pageID?: string;
+    [key: string]: unknown;
+};
+
+const getTocChildren = (page: TocPage | null | undefined): TocPage[] => {
+    if (!page || typeof page !== 'object') return [];
+    if (Array.isArray(page.children)) return page.children;
+    if (Array.isArray(page.subpages)) return page.subpages;
+    return [];
+};
+
+const pageToA11YSection = (page: TocPage): A11YReviewSectionFromTOC | null => {
+    if (!page || typeof page !== 'object') return null;
+    if (typeof page.title !== 'string' || page.title.trim().length === 0) return null;
+    if (typeof page.url !== 'string' || page.url.trim().length === 0) return null;
+    const rawID = page.id ?? page['@id'];
+    return {
+        sectionTitle: page.title,
+        sectionURL: page.url,
+        ...(rawID !== undefined && rawID !== null ? { pageID: String(rawID) } : {}),
+    };
+};
+
+export const buildA11YReviewSectionsFromTOC = (toc: TocPage | null | undefined): A11YReviewSectionFromTOC[] => {
+    const sections: A11YReviewSectionFromTOC[] = [];
+
+    const visit = (pages: TocPage[]) => {
+        pages.forEach((page) => {
+            const section = pageToA11YSection(page);
+            if (section) {
+                sections.push(section);
+            }
+            visit(getTocChildren(page));
+        });
+    };
+
+    visit(getTocChildren(toc));
+    return sections;
+};
+
+export const mergeA11YReviewSectionsFromTOC = (
+    tocSections: A11YReviewSectionFromTOC[],
+    existingSections: A11YReviewSectionFromTOC[] = [],
+): A11YReviewSectionFromTOC[] => {
+    const unmatchedExisting = new Set(existingSections.map((_section, index) => index));
+
+    const takeMatch = (matcher: (existing: A11YReviewSectionFromTOC) => boolean) => {
+        for (const index of unmatchedExisting) {
+            const existing = existingSections[index];
+            if (matcher(existing)) {
+                unmatchedExisting.delete(index);
+                return existing;
+            }
+        }
+        return null;
+    };
+
+    return tocSections.map((section) => {
+        const matchedByURL = takeMatch((existing) => (
+            typeof existing.sectionURL === 'string'
+            && existing.sectionURL.length > 0
+            && existing.sectionURL === section.sectionURL
+        ));
+        const matched = matchedByURL || takeMatch((existing) => (
+            typeof existing.sectionTitle === 'string'
+            && existing.sectionTitle.length > 0
+            && existing.sectionTitle === section.sectionTitle
+        ));
+
+        if (!matched) {
+            return section;
+        }
+
+        return {
+            ...matched,
+            sectionTitle: section.sectionTitle,
+            sectionURL: section.sectionURL,
+            ...(section.pageID ? { pageID: section.pageID } : {}),
+        };
+    });
+};
