+
+for (const applied of [false, true]) {
+  test(`apply reports whether the bridge wrote anything: applied=${applied}`, async () => {
+    const container = document.createElement('div');
+    document.body.appendChild(container);
+    const root = createRoot(container);
+    try {
+      await act(async () => root.render(React.createElement(RemediationPageActions, {
+        base: '/test', section: { id: 'page', title: 'Page' }, item: { _id: 'task', title: 'Image' },
+        request: async (url: string) => {
+          const action = url.split('/').pop();
+          if (action === 'scan') return { findings: [{ id: 'f1', message: 'Duplicate id', fixable: true }], scanned_at: '2026-09-19', page_url: 'https://dev.libretexts.org/Sandboxes/johnnyphung/p' };
+          if (action === 'preview') return { before_html: '<p id="a"></p>', after_html: '<p id="a-2"></p>', diff: '-a\n+a-2', preview_token: 't', preview_hash: 'h' };
+          return { applied, scan: { findings: [] } };
+        },
+        refreshed: async () => {}, onScanSaved: () => {}, close: () => {},
+      })));
+      const click = async (label: string) => act(async () => Array.from(container.querySelectorAll('button')).find(b => b.textContent === label)!.click());
+      await click('Rescan page');
+      await click('Preview selected fix');
+      await act(async () => Array.from(container.querySelectorAll<HTMLInputElement>('input[type=checkbox]')).at(-1)!.click());
+      await click('Apply reviewed fix and rescan');
+      expect(container.textContent?.includes('No changes were written')).toBe(!applied);
+      expect(container.textContent?.includes('Apply completed.')).toBe(applied);
+    } finally { await act(async () => root.unmount()); container.remove(); }
+  });
+}
