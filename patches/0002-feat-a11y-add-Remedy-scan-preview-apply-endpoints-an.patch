+        if (req.body.sectionID && (data.wcag_review || data.wcagReview || data.doj_exceptions || data.dojExceptions)) {
+            const wcagReview = data.wcag_review || data.wcagReview;
+            const dojExceptions = data.doj_exceptions || data.dojExceptions || [];
+            const toSet = {};
+            if (wcagReview) {
+                toSet['a11yReview.$.wcagReview'] = wcagReview;
+            }
+            if (Array.isArray(dojExceptions)) {
+                toSet['a11yReview.$.dojExceptions'] = dojExceptions;
+            }
+            if (Object.keys(toSet).length > 0) {
+                await Project.updateOne({
+                    projectID: project.projectID,
+                    'a11yReview._id': req.body.sectionID,
+                }, {
+                    $set: toSet,
+                });
+            }
+        }
+
+        return res.send({
+            err: false,
+            ...data,
+        });
+    } catch (err) {
+        let errMsg = conductorErrors.err6;
+        let error = undefined;
+        if (err.message === 'notfound') {
+            errMsg = conductorErrors.err11;
+        } else if (err.message === 'unauth') {
