+const getProjectRemedyBaseUrl = () => {
+    const raw = process.env.REMEDY_API_BASE_URL || process.env.PROJECT_REMEDY_BASE_URL || 'http://127.0.0.1:8000';
+    return raw.replace(/\/+$/, '');
+};
+
+
+const getProjectRemedyHeaders = () => {
+    const headers = {
+        'Content-Type': 'application/json',
     };
+    const apiKey = process.env.REMEDY_API_KEY || process.env.PROJECT_REMEDY_API_KEY;
+    if (typeof (apiKey) === 'string' && apiKey.length > 0) {
+        headers['X-API-Key'] = apiKey;
+    }
+    return headers;
+};
+
+
+const getProjectRemedyErrorMessage = (err) => {
+    if (err?.response?.data?.detail) {
+        if (typeof (err.response.data.detail) === 'string') {
+            return err.response.data.detail;
+        }
+        if (typeof (err.response.data.detail) === 'object' && typeof (err.response.data.detail.message) === 'string') {
+            return err.response.data.detail.message;
+        }
+    }
+    if (typeof (err?.message) === 'string' && err.message.length > 0) {
+        return err.message;
+    }
+    return conductorErrors.err6;
+};
+
+
+const proxyProjectRemedyRequest = async (endpoint, body) => {
+    return axios.post(
+        `${getProjectRemedyBaseUrl()}${endpoint}`,
+        body,
+        {
+            headers: getProjectRemedyHeaders(),
+            validateStatus: () => true,
+        },
+    ).then((response) => {
+        if (response.status >= 200 && response.status < 300) {
+            return response.data;
+        }
+        const detail = response.data?.detail;
+        const err = new Error(
+            typeof (detail) === 'string'
+                ? detail
+                : (typeof (detail?.message) === 'string' ? detail.message : conductorErrors.err6),
+        );
+        err.backendStatus = response.status;
+        err.backendCode = detail?.error;
+        throw err;
+    });
+};
+
+
+function pagePathFromSectionUrl(rawUrl) {
+    if (!rawUrl || typeof rawUrl !== 'string') return '';
+    try {
+        const url = new URL(rawUrl);
+        return decodeURIComponent(url.pathname.replace(/^\/+/, ''));
+    } catch (_e) {
+        return rawUrl.replace(/^\/+/, '');
+    }
+}
+
+
+function isSandboxSectionUrl(rawUrl) {
+    const pagePath = pagePathFromSectionUrl(rawUrl);
+    return /(^|\/)Sandboxes(\/|$)/.test(pagePath);
+}
+
+const checkProjectRemedyHealth = async (_req, res) => {
+    try {
+        const response = await axios.get(`${getProjectRemedyBaseUrl()}/healthz`, {
+            headers: getProjectRemedyHeaders(),
+            validateStatus: () => true,
+        });
+        if (response.status >= 200 && response.status < 300) {
+            return res.send({ err: false, ok: true });
+        }
+        return res.send({
+            err: true,
+            errMsg: `Remedy Server health check failed (${response.status}).`,
+            status: response.status,
+        });
+    } catch (err) {
+        return res.send({
+            err: true,
+            errMsg: getProjectRemedyErrorMessage(err),
+        });
+    }
+};
