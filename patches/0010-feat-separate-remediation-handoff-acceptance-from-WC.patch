--- /dev/null
+++ b/server/util/remediationHandoff.ts
@@ -0,0 +1,40 @@
+import { createHash } from 'node:crypto';
+import { MAX_EVIDENCE_AGE_MS } from './conformance.js';
+
+export const deferredWork = [
+  { id: 'reader', title: 'Reader accessibility', scope: 'Shared reader navigation, styling, integrations, embedded services and resource-load issues.' },
+  { id: 'human-testing', title: 'Human accessibility testing', scope: 'Screen-reader math reading and exploration, keyboard operation and the remaining manual WCAG criterion reviews.' },
+];
+
+/** Delivery acceptance is independent of WCAG conformance and never changes criterion results. */
+export function remediationHandoff(report: any, signoffs: any[], now = Date.now()) {
+  const blockers: string[] = [];
+  if (!report.scope?.version) blockers.push('Define the evaluation scope before accepting the remediation handoff.');
+  if (!report.pages.length) blockers.push('Add pages and scan the remediation delivery.');
+  const missing = report.pages.filter((p: any) => {
+    const w = p.sourceScan, scanned = Date.parse(w?.scannedAt);
+    return !w?.sourceHash || !Number.isFinite(scanned) || scanned > now + 60000 || now - scanned > MAX_EVIDENCE_AGE_MS;
+  });
+  if (missing.length) blockers.push(`${missing.length} pages require a current source scan before delivery acceptance.`);
+  const outstanding = {
+    failedPageCriteria: report.pages.reduce((n: number, p: any) => n + (p.sourceScan?.criteria || []).filter((c: any) => c.status === 'fail').length, 0),
+    readerPagesNeedingFollowup: report.pages.filter((p: any) => p.sourceScan?.rendered?.state !== 'complete' || p.sourceScan?.rendered?.violations?.length).length,
+    unverifiedPageCriteria: report.totalCriteria - report.verifiedCriteria,
+  };
+  const digest = createHash('sha256').update(JSON.stringify({
+    purpose: 'remediation-handoff-v1', evaluationDigest: report.digest, deferredWork, outstanding,
+    pages: report.pages.map((p: any) => [p.sectionID, p.url, p.sourceScan?.sourceHash, p.sourceScan?.scannedAt, p.sourceScan?.rendered?.scannedAt]),
+  })).digest('hex');
+  const signoff = !blockers.length ? signoffs.find(s => s.digest === digest) || null : null;
+  return { status: signoff ? 'accepted_for_remediation_handoff' : signoffs.length ? 'acceptance_stale' : 'awaiting_acceptance',
+    readyForSignoff: !blockers.length, blockers, digest, deferredWork, outstanding, signoff,
+    limitations: 'Accepts the current remediation delivery with the listed outstanding findings and deferred projects. Does not verify WCAG conformance or complete human accessibility testing. New evidence, scope or content changes require renewed acceptance.' };
+}
+
+export function validateRemediationHandoff(body: any, handoff: any) {
+  if (!handoff.readyForSignoff || body?.digest !== handoff.digest) throw Error('Delivery evidence changed or source scans are missing. Refresh before signing.');
+  if (body.confirmed !== true || body.deferredConfirmed !== true) throw Error('Confirm delivery acceptance and the deferred reader and human-testing projects.');
+  if (typeof body.statement !== 'string' || body.statement.trim().length < 40 || body.statement.length > 4000) throw Error('Provide a delivery acceptance statement (40–4,000 characters).');
+  return { digest: handoff.digest, statement: body.statement.trim(), deferredWork: handoff.deferredWork,
+    outstanding: handoff.outstanding, limitations: handoff.limitations };
+}
