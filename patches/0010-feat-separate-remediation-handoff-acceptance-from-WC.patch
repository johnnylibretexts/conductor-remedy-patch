+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { conformanceReport, criteria } from './conformance.js';
+import { remediationHandoff, validateRemediationHandoff } from './remediationHandoff.js';
+const now = Date.now(), at = new Date(now).toISOString();
+function evaluation() {
+  return conformanceReport({a11yReview:[{_id:'one',sectionURL:'https://dev.libretexts.org/Sandboxes/johnnyphung/book',wcagReview:{sourceHash:'v1',scannedAt:at,criteria:criteria.map(c=>({...c,status:'fail'})),rendered:{state:'incomplete',sourceHash:'v1',renderedHash:'r1',platformHash:'p1',scannedAt:at,violations:[{id:'link-name'}]}}}]},{version:'scope',boundaries:'Full pages',processes:'Reader navigation'},[],[],now);
+}
+test('delivery acceptance permits deferred reader failures and human reviews without establishing conformance',()=>{
+ const report=evaluation(),handoff=remediationHandoff(report,[],now);
+ assert.equal(handoff.readyForSignoff,true);assert.equal(report.readyForSignoff,false);
+ assert.deepEqual(handoff.outstanding,{failedPageCriteria:50,readerPagesNeedingFollowup:1,unverifiedPageCriteria:50});
+ const body={digest:handoff.digest,confirmed:true,deferredConfirmed:true,statement:'Accept the current delivery; reader and human accessibility work remains deferred.'};
+ const saved=validateRemediationHandoff(body,handoff);
+ assert.equal(remediationHandoff(report,[saved],now).status,'accepted_for_remediation_handoff');
+ assert.equal(report.status,'verification_pending');assert.equal(report.verifiedCriteria,0);
+ assert.equal(saved.deferredWork.length,2);
+});
+test('missing scope, missing source evidence and stale source scans still prevent delivery acceptance',()=>{
+ for(const mutate of [(r:any)=>r.scope=null,(r:any)=>r.pages=[],(r:any)=>delete r.pages[0].sourceScan.sourceHash,(r:any)=>r.pages[0].sourceScan.scannedAt='2020-01-01',(r:any)=>r.pages[0].sourceScan.scannedAt=new Date(now+120000).toISOString()]){
+  const r=evaluation();mutate(r);assert.equal(remediationHandoff(r,[],now).readyForSignoff,false);
+ }
+});
+test('changed delivery or evidence invalidates acceptance and forged fields cannot replace deferred work',()=>{
+ const report=evaluation(),handoff=remediationHandoff(report,[],now),body={digest:handoff.digest,statement:'Accept the current delivery with unresolved accessibility work recorded.',confirmed:true,deferredConfirmed:true};
+ for(const patch of [{digest:'old'},{confirmed:false},{deferredConfirmed:false},{statement:'ok'}])assert.throws(()=>validateRemediationHandoff({...body,...patch},handoff));
+ const saved=validateRemediationHandoff({...body,deferredWork:[],outstanding:{},actor:'forged'},handoff);
+ assert.equal(saved.deferredWork.length,2);assert.equal((saved as any).actor,undefined);
+ for(const mutate of [(r:any)=>r.digest='new-scope-or-rendering',(r:any)=>r.pages[0].sourceScan.sourceHash='v2',(r:any)=>r.pages[0].sourceScan.scannedAt=new Date(now+1).toISOString(),(r:any)=>r.pages[0].sourceScan.criteria[0].status='pass']){
+  const r=evaluation();mutate(r);assert.equal(remediationHandoff(r,[saved],now).status,'acceptance_stale');
+ }
+});
diff --git a/server/util/remediationHandoff.ts b/server/util/remediationHandoff.ts
