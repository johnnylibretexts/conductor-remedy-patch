+const WCAG_PRINCIPLES = ['Perceivable', 'Operable', 'Understandable', 'Robust'];
+
+const WCAG_STATUS_LABELS = {
+    pass: 'Pass',
+    fail: 'Fail',
+    not_applicable: 'N/A',
+    manual_review: 'Manual',
+    not_tested: 'Not tested',
+};
