+                                                </span>
+                                            )}
+                                        </summary>
+                                        <WcagCriteriaDetails review={review} section={section} />
+                                    </details>
+                                </Table.Cell>
+                            </Table.Row>
+                        </React.Fragment>
+                    );
+                })}
+                {sections.length === 0 && (
+                    <Table.Row>
+                        <Table.Cell colSpan={6}>
+                            <span><em>No sections added yet.</em></span>
+                        </Table.Cell>
+                    </Table.Row>
+                )}
+            </Table.Body>
+        </Table>
+    </div>
+);
 
