+export const A11Y_SCORE_KEYS = [
+  "navKeyboard",
+  "imgAltText",
+  "imgDecorative",
+  "imgShortAlt",
+  "linkNoneEmpty",
+  "linkSuspicious",
+  "linkExtLabeled",
+  "contrastSmall",
+  "contrastLarge",
+  "contrastButtons",
+  "textSize",
+  "textLineHeight",
+  "textParSpacing",
+  "textLetterSpacing",
+  "textWordSpacing",
+  "headingNoneEmpty",
+  "headingOutline",
+  "formFieldLabels",
+  "formNavRadio",
+  "tableHeaders",
+  "tableLabel",
+  "tableNotImage",
+  "listOlLabel",
+  "listUlLabel",
+  "docLinkFile",
+  "docAccess",
+  "multiCaption",
+  "multiNavControls",
+  "multiAudioTrans",
+  "multiAudioDescrip",
+  "divSection",
+  "senseInstruction",
+  "timingCriteria",
+  "codeAltText",
+] as const;
+
+export type A11yScoreSummary = {
+  passingCount: number;
+  populatedCount: number;
+  percent: number;
+};
+
+export type WcagProjectSummary = {
+  reviewedPageCount: number;
+  score: number | null;
+  scorePassCount: number;
+  scoreFailCount: number;
+  scoreDenominator: number;
+  failCount: number;
+  manualReviewCount: number;
+  notTestedCount: number;
+  verifiedExceptionCount: number;
+  notApplicableCount: number;
+};
+
+export function computeA11yScore(
+  reviewSections: Array<Record<string, unknown>>,
+): A11yScoreSummary {
+  let passingCount = 0;
+  let populatedCount = 0;
+
+  reviewSections.forEach((section) => {
+    A11Y_SCORE_KEYS.forEach((key) => {
+      const value = section[key];
+      if (typeof value === "boolean") {
+        populatedCount += 1;
+        if (value) {
+          passingCount += 1;
+        }
+      }
+    });
+  });
+
+  return {
+    passingCount,
+    populatedCount,
+    percent:
+      populatedCount > 0
+        ? Math.round((passingCount / populatedCount) * 100)
+        : 0,
+  };
+}
+
+function getSectionWcagReview(section: Record<string, unknown>) {
+  return (
+    (section.wcagReview as Record<string, unknown> | undefined)
+    || (section.wcag_review as Record<string, unknown> | undefined)
+    || null
+  );
+}
+
+function readSummaryCount(summary: Record<string, unknown>, key: string): number {
+  const value = summary[key];
+  return typeof value === "number" && Number.isFinite(value) ? value : 0;
+}
+
+export function computeWcagProjectSummary(
+  reviewSections: Array<Record<string, unknown>>,
+): WcagProjectSummary {
+  const summary: WcagProjectSummary = {
+    reviewedPageCount: 0,
+    score: null,
+    scorePassCount: 0,
+    scoreFailCount: 0,
+    scoreDenominator: 0,
+    failCount: 0,
+    manualReviewCount: 0,
+    notTestedCount: 0,
+    verifiedExceptionCount: 0,
+    notApplicableCount: 0,
+  };
+
+  reviewSections.forEach((section) => {
+    const review = getSectionWcagReview(section);
+    const reviewSummary = review?.summary;
+    if (!reviewSummary || typeof reviewSummary !== "object") return;
+
+    summary.reviewedPageCount += 1;
+    summary.scorePassCount += readSummaryCount(
+      reviewSummary as Record<string, unknown>,
+      "scorePassCount",
+    );
+    summary.scoreFailCount += readSummaryCount(
+      reviewSummary as Record<string, unknown>,
+      "scoreFailCount",
+    );
+    summary.failCount += readSummaryCount(
+      reviewSummary as Record<string, unknown>,
+      "failCount",
+    );
+    summary.manualReviewCount += readSummaryCount(
+      reviewSummary as Record<string, unknown>,
+      "manualReviewCount",
+    );
+    summary.notTestedCount += readSummaryCount(
+      reviewSummary as Record<string, unknown>,
+      "notTestedCount",
+    );
+    summary.verifiedExceptionCount += readSummaryCount(
+      reviewSummary as Record<string, unknown>,
+      "verifiedExceptionCount",
+    );
+    summary.notApplicableCount += readSummaryCount(
+      reviewSummary as Record<string, unknown>,
+      "notApplicableCount",
+    );
+  });
+
+  summary.scoreDenominator = summary.scorePassCount + summary.scoreFailCount;
+  summary.score = summary.scoreDenominator > 0
+    ? Math.round((summary.scorePassCount / summary.scoreDenominator) * 100)
+    : null;
+  return summary;
+}
