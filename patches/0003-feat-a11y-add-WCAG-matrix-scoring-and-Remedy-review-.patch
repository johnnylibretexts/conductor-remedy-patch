+const FINDING_KIND_TO_CRITERIA = {
+    'img-alt-missing': ['imgAltText'],
+    'img-decorative-suspect': ['imgDecorative'],
+    'img-alt-too-long': ['imgShortAlt'],
+    'heading-empty': ['headingNoneEmpty'],
+    'heading-skipped-level': ['headingOutline'],
+    'form-label-missing': ['formFieldLabels'],
+    'table-header-missing': ['tableHeaders'],
+    'table-label-missing': ['tableLabel'],
+    'list-structure-invalid': ['listOlLabel', 'listUlLabel'],
+    'link-empty': ['linkNoneEmpty'],
+    'link-bare-url': ['linkSuspicious'],
