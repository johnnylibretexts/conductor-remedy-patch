+                                        <span className='wcag-level'>{criterion.level}</span>
+                                    </div>
+                                    <p>{criterion.applicabilityReason}</p>
+                                    {Array.isArray(criterion.evidence) && criterion.evidence.length > 0 && (
+                                        <details>
+                                            <summary>{criterion.evidence.length} evidence item(s)</summary>
+                                            <ul className='wcag-evidence-list'>
+                                                {criterion.evidence.slice(0, 5).map((evidence, evidenceIndex) => (
+                                                    <li key={`${criterion.id}-${evidence.findingId || evidence.ruleId}-${evidenceIndex}`} className='wcag-evidence-item'>
+                                                        <div className='wcag-evidence-message'>
+                                                            <strong>{evidence.ruleId}</strong>
+                                                            {evidence.fixable && <span className='muted-text'> fixable</span>}
+                                                            {!evidence.fixable && evidence.fixBlockedReason === 'broken-image-url' && (
+                                                                <span className='wcag-evidence-badge wcag-evidence-badge-warning'>broken image</span>
+                                                            )}
+                                                            <div>{evidence.message}</div>
+                                                            {evidence.fixBlockedMessage && (
+                                                                <div className='muted-text'>{evidence.fixBlockedMessage}</div>
+                                                            )}
+                                                        </div>
+                                                        <div className='wcag-evidence-actions'>
+                                                            {evidence.selector && <code>{evidence.selector}</code>}
+                                                            <EvidenceBookLink section={section} evidence={evidence} compact />
+                                                        </div>
+                                                        {evidence.snippet && (
+                                                            <details className='wcag-evidence-snippet'>
+                                                                <summary>HTML snippet</summary>
+                                                                <code>{evidence.snippet}</code>
+                                                            </details>
+                                                        )}
+                                                    </li>
+                                                ))}
+                                                {criterion.evidence.length > 5 && (
+                                                    <li className='muted-text'>Showing first 5 of {criterion.evidence.length}.</li>
+                                                )}
+                                            </ul>
+                                        </details>
+                                    )}
+                                </div>
+                            ))}
+                        </div>
+                    </div>
+                );
+            })}
+        </div>
+    );
+};
+
+const PreviewDiffPanel = ({ previewData, selectedCount, panelRef }) => {
+    if (!previewData) return null;
+    const diff = typeof (previewData.diff) === 'string' ? previewData.diff : '';
+    const lines = diff.split('\n');
+    const stats = getDiffStats(diff);
+    return (
+        <div ref={panelRef}>
+            <Segment className='mt-1p remedy-preview-segment'>
+                <Header as='h4'>Proposed changes</Header>
+                <Segment color='green' className='mt-1p'>
+                    Preview is ready. Review the proposed changes before applying them.
+                </Segment>
+                <div className='remedy-preview-summary'>
+                    <div className='remedy-preview-metric'>
+                        <strong>{previewData.page_wide ? 'Page' : selectedCount}</strong>
+                        <span>{previewData.page_wide ? 'preview scope' : 'selected issues'}</span>
+                    </div>
+                    <div className='remedy-preview-metric'>
+                        <strong>{Array.isArray(previewData.applied_rule_ids) ? previewData.applied_rule_ids.length : 0}</strong>
+                        <span>rules with changes</span>
+                    </div>
+                    <div className='remedy-preview-metric'>
+                        <strong>{stats.additions}</strong>
+                        <span>added lines</span>
+                    </div>
+                    <div className='remedy-preview-metric'>
+                        <strong>{stats.deletions}</strong>
+                        <span>removed lines</span>
+                    </div>
+                </div>
+                {previewData.noise_only_change && (
+                    <Segment color='yellow' className='mt-1p'>
+                        Remedy only found formatting changes, so applying is blocked until a real content change is available.
+                    </Segment>
+                )}
+                {Array.isArray(previewData.fix_errors) && previewData.fix_errors.length > 0 && (
+                    <Segment color='yellow' className='mt-1p'>
+                        <Header as='h5'>Fixes needing review</Header>
+                        <ul>
+                            {previewData.fix_errors.map((item, index) => (
+                                <li key={`${item.findingId || item.ruleId || 'fix'}-${index}`}>
+                                    <strong>{item.findingId || item.ruleId || 'Finding'}:</strong> {item.message}
+                                </li>
+                            ))}
+                        </ul>
+                    </Segment>
+                )}
+                <div className='remedy-rule-summary'>
+                    <RuleList label='Attempted rules' rules={previewData.attempted_rule_ids} />
+                    <RuleList label='Rules that changed HTML' rules={previewData.applied_rule_ids} />
+                </div>
+                <details className='remedy-diff-details'>
+                    <summary>Show HTML diff</summary>
+                    {diff.trim() ? (
+                        <pre className='remedy-diff'>
+                            {lines.map((line, index) => (
+                                <span key={`${index}-${line.slice(0, 20)}`} className={getDiffLineClass(line)}>
+                                    {line || ' '}
+                                    {'\n'}
+                                </span>
+                            ))}
+                        </pre>
+                    ) : (
+                        <p className='muted-text remedy-diff-empty'>No HTML changes were produced for this preview.</p>
+                    )}
+                </details>
+            </Segment>
+        </div>
+    );
+};
