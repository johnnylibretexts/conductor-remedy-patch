+                                        />
+                                    ) : (
+                                        <span className='muted-text'>No fixable findings</span>
+                                    )}
+                                </Table.Cell>
+                            </Table.Row>
+                            <Table.Row className='wcag-section-details-row'>
+                                <Table.Cell colSpan={6} className='wcag-details-cell'>
+                                    <details className='wcag-section-details'>
+                                        <summary>
+                                            <span className='wcag-section-details-title'>
