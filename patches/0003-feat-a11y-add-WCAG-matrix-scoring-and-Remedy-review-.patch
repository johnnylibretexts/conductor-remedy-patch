+const WcagCriteriaDetails = ({ review, section }) => {
+    if (!review?.criteria?.length) {
+        return (
+            <p className='muted-text mb-0'>
+                No WCAG review has been stored for this page yet. Run Remedy to populate WCAG 2.1 A/AA status.
+            </p>
