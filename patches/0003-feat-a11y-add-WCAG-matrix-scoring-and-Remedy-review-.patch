+    return (
+        <div className='wcag-criteria-details'>
+            {WCAG_PRINCIPLES.map((principle) => {
+                const criteria = review.criteria.filter((criterion) => criterion.principle === principle);
+                if (criteria.length === 0) return null;
+                return (
+                    <div key={principle} className='wcag-principle-group'>
+                        <Header as='h4'>{principle}</Header>
+                        <div className='wcag-criteria-grid'>
+                            {criteria.map((criterion) => (
+                                <div key={criterion.id} className={`wcag-criterion-card wcag-criterion-${criterion.status}`}>
+                                    <div className='wcag-criterion-title'>
+                                        <WcagStatusLabel status={criterion.status} />
+                                        <strong>{criterion.id}</strong>
