+const SUPPORTED_SCAN_KEYS = [
+    'imgAltText',
+    'imgDecorative',
+    'imgShortAlt',
+    'headingNoneEmpty',
+    'headingOutline',
+    'formFieldLabels',
+    'tableHeaders',
+    'tableLabel',
+    'listOlLabel',
+    'listUlLabel',
+    'linkNoneEmpty',
+    'linkSuspicious',
