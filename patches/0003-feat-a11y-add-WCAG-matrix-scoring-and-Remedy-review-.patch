+const wait = (ms) => new Promise((resolve) => window.setTimeout(resolve, ms));
+
+const getFixableFindings = (findings) => {
+    if (!Array.isArray(findings)) return [];
+    return findings.filter((finding) => finding.fixable);
+};
+
+const getFindingWcagIDs = (finding) => {
+    if (Array.isArray(finding?.wcagCriterionIds)) return finding.wcagCriterionIds;
+    if (Array.isArray(finding?.wcag_criterion_ids)) return finding.wcag_criterion_ids;
+    return [];
+};
+
+const getAffectedCriteriaKeys = (findings) => {
+    const keys = new Set();
+    if (!Array.isArray(findings)) return [];
+    findings.forEach((finding) => {
+        if (Array.isArray(finding.criteria_keys)) {
+            finding.criteria_keys.forEach((key) => keys.add(key));
+            return;
+        }
+        const mapped = FINDING_KIND_TO_CRITERIA[finding.kind] || [];
+        mapped.forEach((key) => keys.add(key));
+    });
+    return Array.from(keys);
+};
+
+const getSectionWcagReview = (section) => section?.wcagReview || section?.wcag_review || null;
+
+const getFixableWcagEvidence = (section) => {
+    const review = getSectionWcagReview(section);
+    if (!Array.isArray(review?.criteria)) return [];
+    const evidenceItems = [];
+    review.criteria.forEach((criterion) => {
+        if (!Array.isArray(criterion.evidence)) return;
+        criterion.evidence.forEach((evidence, evidenceIndex) => {
+            if (evidence?.fixable) {
+                evidenceItems.push({
+                    ...evidence,
+                    criterionId: criterion.id,
+                    criterionTitle: criterion.title,
+                    evidenceIndex,
+                });
+            }
+        });
+    });
+    return evidenceItems;
+};
+
+const getFixableWcagEvidenceCount = (section) => {
+    return getFixableWcagEvidence(section).length;
+};
+
+const getFixableFindingCount = (findings) => {
+    return getFixableFindings(findings).length;
+};
+
+const getSectionDojExceptions = (section) => {
+    if (Array.isArray(section?.dojExceptions)) return section.dojExceptions;
+    if (Array.isArray(section?.doj_exceptions)) return section.doj_exceptions;
+    return [];
+};
+
+const getWcagReviewFromResponse = (data) => data?.wcagReview || data?.wcag_review || null;
+
+const getDojExceptionsFromResponse = (data) => {
+    if (Array.isArray(data?.dojExceptions)) return data.dojExceptions;
+    if (Array.isArray(data?.doj_exceptions)) return data.doj_exceptions;
+    return [];
+};
+
+const hasRemedyScanTarget = (section) => {
+    if (!isEmptyString(section?.sectionURL)) return true;
+    if (typeof (section?.pageID) === 'number') return Number.isFinite(section.pageID) && section.pageID > 0;
+    if (typeof (section?.pageID) === 'string') return section.pageID.trim().length > 0;
+    return false;
+};
+
+const getSelectorAnchor = (selector) => {
+    if (typeof (selector) !== 'string') return '';
+    const directId = selector.match(/#([A-Za-z][\w:.-]*)/);
+    if (directId) return directId[1];
+    const quotedId = selector.match(/\[id=["']([^"']+)["']\]/);
+    return quotedId ? quotedId[1] : '';
+};
+
+const getEvidenceReviewURL = (section, evidence = {}) => {
+    if (isEmptyString(section?.sectionURL)) return '';
+    const anchor = getSelectorAnchor(evidence.selector);
+    if (isEmptyString(anchor)) return section.sectionURL;
+    try {
+        const url = new URL(section.sectionURL);
+        url.hash = anchor;
+        return url.toString();
+    } catch (_err) {
+        return `${section.sectionURL}#${encodeURIComponent(anchor)}`;
+    }
+};
+
+const getDiffStats = (diff = '') => {
+    const stats = { additions: 0, deletions: 0 };
+    diff.split('\n').forEach((line) => {
+        if (line.startsWith('+++') || line.startsWith('---')) return;
+        if (line.startsWith('+')) stats.additions += 1;
+        if (line.startsWith('-')) stats.deletions += 1;
+    });
+    return stats;
+};
+
+const getDiffLineClass = (line) => {
+    if (line.startsWith('+++') || line.startsWith('---') || line.startsWith('@@') || line.startsWith('Index:') || line.startsWith('===')) {
+        return 'remedy-diff-meta';
+    }
+    if (line.startsWith('+')) return 'remedy-diff-add';
+    if (line.startsWith('-')) return 'remedy-diff-del';
+    return '';
+};
+
