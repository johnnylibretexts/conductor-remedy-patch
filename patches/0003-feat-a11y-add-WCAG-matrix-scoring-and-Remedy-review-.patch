+import { computeA11yScore, computeWcagProjectSummary } from "./accessibilityScore";
+
+test("computeA11yScore returns zeroes for no populated cells", () => {
+  const result = computeA11yScore([{ sectionTitle: "One", sectionURL: "/one" }]);
+  expect(result).toEqual({
+    passingCount: 0,
+    populatedCount: 0,
+    percent: 0,
+  });
+});
+
+test("computeA11yScore ignores undefined cells", () => {
+  const result = computeA11yScore([
+    {
+      sectionTitle: "One",
+      imgAltText: true,
+      headingOutline: false,
+      formFieldLabels: undefined,
+    },
+  ]);
+  expect(result.populatedCount).toBe(2);
+  expect(result.passingCount).toBe(1);
+  expect(result.percent).toBe(50);
+});
+
+test("computeA11yScore returns 100 for all populated true", () => {
+  const result = computeA11yScore([
+    {
+      imgAltText: true,
+      headingOutline: true,
+      formFieldLabels: true,
+      tableHeaders: true,
+    },
+  ]);
+  expect(result.populatedCount).toBe(4);
+  expect(result.passingCount).toBe(4);
+  expect(result.percent).toBe(100);
+});
+
+test("computeA11yScore rounds mixed results", () => {
+  const result = computeA11yScore([
+    {
+      imgAltText: true,
+      headingOutline: false,
+      formFieldLabels: false,
+    },
+    {
+      tableHeaders: true,
+    },
+  ]);
+  expect(result.populatedCount).toBe(4);
+  expect(result.passingCount).toBe(2);
+  expect(result.percent).toBe(50);
+});
+
+test("computeA11yScore includes expanded Remedy scanner criteria", () => {
+  const result = computeA11yScore([
+    {
+      imgDecorative: false,
+      imgShortAlt: true,
+      linkExtLabeled: false,
+      tableLabel: true,
+      listOlLabel: false,
+      listUlLabel: true,
+      docLinkFile: false,
+    },
+  ]);
+
+  expect(result.populatedCount).toBe(7);
+  expect(result.passingCount).toBe(3);
+  expect(result.percent).toBe(43);
+});
+
+test("computeWcagProjectSummary aggregates stored WCAG review summaries", () => {
+  const result = computeWcagProjectSummary([
+    {
+      sectionTitle: "01: Introduction",
+      wcagReview: {
+        summary: {
+          scorePassCount: 8,
+          scoreFailCount: 2,
+          failCount: 2,
+          manualReviewCount: 4,
+          notTestedCount: 1,
+          verifiedExceptionCount: 1,
+          notApplicableCount: 12,
+        },
+      },
+    },
+    {
+      sectionTitle: "1.01: Studying Chemistry",
+      wcag_review: {
+        summary: {
+          scorePassCount: 6,
+          scoreFailCount: 4,
+          failCount: 4,
+          manualReviewCount: 3,
+          notTestedCount: 0,
+          verifiedExceptionCount: 2,
+          notApplicableCount: 10,
+        },
+      },
+    },
+    {
+      sectionTitle: "Unscanned page",
+    },
+  ]);
+
+  expect(result.reviewedPageCount).toBe(2);
+  expect(result.scorePassCount).toBe(14);
+  expect(result.scoreFailCount).toBe(6);
+  expect(result.scoreDenominator).toBe(20);
+  expect(result.score).toBe(70);
+  expect(result.failCount).toBe(6);
+  expect(result.manualReviewCount).toBe(7);
+  expect(result.notTestedCount).toBe(1);
+  expect(result.verifiedExceptionCount).toBe(3);
+  expect(result.notApplicableCount).toBe(22);
+});
+
+test("computeWcagProjectSummary excludes manual review and untested counts from score denominator", () => {
+  const result = computeWcagProjectSummary([
+    {
+      wcagReview: {
+        summary: {
+          scorePassCount: 1,
+          scoreFailCount: 1,
+          manualReviewCount: 48,
+          notTestedCount: 50,
+          notApplicableCount: 25,
+          verifiedExceptionCount: 5,
+        },
+      },
+    },
+  ]);
+
+  expect(result.scoreDenominator).toBe(2);
+  expect(result.score).toBe(50);
+  expect(result.manualReviewCount).toBe(48);
+  expect(result.notTestedCount).toBe(50);
+});
+
+test("computeWcagProjectSummary reports null score when only not-applicable/manual states exist", () => {
+  const result = computeWcagProjectSummary([
+    {
+      wcagReview: {
+        summary: {
+          scorePassCount: 0,
+          scoreFailCount: 0,
+          manualReviewCount: 4,
+          notApplicableCount: 46,
+        },
+      },
+    },
+  ]);
+
+  expect(result.reviewedPageCount).toBe(1);
+  expect(result.scoreDenominator).toBe(0);
+  expect(result.score).toBe(null);
+});
